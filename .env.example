# Hyperliquid wallet private key (never commit the real .env)
HL_PRIVATE_KEY=0x...

# Hyperliquid account address
HL_ACCOUNT_ADDRESS=0x...

# Use testnet by default; set to false for mainnet
HL_TESTNET=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Webhook URL for entry/exit/halt alerts (Discord-compatible). Leave unset for none.
ALERT_WEBHOOK_URL=
# Minimum loguru level for the webhook sink (entries/exits are sent explicitly).
ALERT_MIN_LEVEL=WARNING

# Heartbeat URL — healthchecks.io / uptime-kuma push monitor. Leave unset for none.
HEARTBEAT_URL=
# Heartbeat interval in seconds (default 300 = 5 min).
HEARTBEAT_INTERVAL_SECONDS=300
